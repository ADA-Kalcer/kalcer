{"abstract":[{"type":"text","text":"Detailed implementation examples and code patterns used in the Arca app."}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide provides specific implementation details, code examples, and"},{"type":"text","text":" "},{"type":"text","text":"best practices for key features in the Arca codebase."}]},{"text":"Core Data Implementation","anchor":"Core-Data-Implementation","type":"heading","level":2},{"text":"Statue Model","anchor":"Statue-Model","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"The primary data model for statue information:","type":"text"}]},{"code":["  @Model","  final class StatueModel {","      @Attribute(.unique) var id: UUID","      var name: String","      var culturalName: String?","      var latitude: Double","      var longitude: Double","      var category: StatueCategory","      var culturalDescription: String","      var historicalPeriod: String?","      var sculptor: String?","      var constructionYear: Int?","      var materials: [String]","      var dimensions: StatueDimensions","      var isBookmarked: Bool = false","","      init(name: String, latitude: Double, longitude: Double, category:","      StatueCategory) {","          self.id = UUID()","          self.name = name","          self.latitude = latitude","          self.longitude = longitude","          self.category = category","          self.materials = []","          self.dimensions = StatueDimensions()","      }","    }"],"type":"codeListing","syntax":"swift"},{"text":"Category Enumeration","anchor":"Category-Enumeration","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Defines the two main types of statues in Balinese culture:"}]},{"code":["  enum StatueCategory: String, CaseIterable, Codable {","      case ritual = \"ritual\"","      case monumental = \"monumental\"","","      var displayName: String {","          switch self {","          case .ritual:","              return \"Sacred Ritual\"","          case .monumental:","              return \"Historical Monument\"","          }","      }","  }"],"type":"codeListing","syntax":"swift"},{"text":"Location Manager Implementation","anchor":"Location-Manager-Implementation","type":"heading","level":2},{"text":"Core Location Setup","anchor":"Core-Location-Setup","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Handles GPS tracking and proximity detection:","type":"text"}]},{"code":["  @Observable","  final class LocationManager: NSObject, CLLocationManagerDelegate {","      private let manager = CLLocationManager()","      private let geofenceRadius: CLLocationDistance = 50.0","","  var currentLocation: CLLocation?","  var nearbyStatues: [StatueModel] = []","  var isLocationAuthorized = false","","  override init() {","      super.init()","      manager.delegate = self","      manager.desiredAccuracy = kCLLocationAccuracyNearestTenMeters","      manager.distanceFilter = 10.0","  }","","  func requestLocationPermission() {","      manager.requestWhenInUseAuthorization()","  }","","  func startLocationUpdates() {","      guard isLocationAuthorized else { return }","      manager.startUpdatingLocation()","  }","  }"],"type":"codeListing","syntax":"swift"},{"text":"Audio Tour Implementation","anchor":"Audio-Tour-Implementation","type":"heading","level":2},{"text":"Audio Engine Setup","anchor":"Audio-Engine-Setup","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handles background-compatible audio playback:"}]},{"code":["  @Observable","  final class AudioTourManager: NSObject, AVAudioPlayerDelegate {","      private var audioEngine = AVAudioEngine()","      private var playerNode = AVAudioPlayerNode()","      private var mixer = AVAudioMixerNode()","","  var isPlaying = false","  var currentStatue: StatueModel?","  var volume: Float = 0.8","","  override init() {","      super.init()","      setupAudioEngine()","      setupAudioSession()","  }","","  private func setupAudioEngine() {","      audioEngine.attach(playerNode)","      audioEngine.attach(mixer)","","      audioEngine.connect(playerNode, to: mixer, format: nil)","      audioEngine.connect(mixer, to: audioEngine.outputNode, format: nil)","","      do {","          try audioEngine.start()","      } catch {","          print(\"Failed to start audio engine: \\(error)\")","      }","  }","  }"],"type":"codeListing","syntax":"swift"},{"text":"Audio Session Configuration","anchor":"Audio-Session-Configuration","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Enables background playback and music app compatibility:","type":"text"}]},{"code":["  extension AudioTourManager {","      private func setupAudioSession() {","          do {","              try AVAudioSession.sharedInstance().setCategory(","                  .playback,","                  mode: .spokenAudio,","                  options: [.duckOthers, .allowBluetooth]","              )","              try AVAudioSession.sharedInstance().setActive(true)","          } catch {","              print(\"Failed to setup audio session: error)\")","          }","      }","","  func playNarration(for statue: StatueModel) {","      guard let audioURL = audioURL(for: statue) else { return }","","      do {","          let audioFile = try AVAudioFile(forReading: audioURL)","          playerNode.scheduleFile(audioFile, at: nil) { [weak self] in","              DispatchQueue.main.async {","                  self?.isPlaying = false","                  self?.currentStatue = nil","              }","          }","","          if !audioEngine.isRunning {","              try audioEngine.start()","          }","","          playerNode.play()","          isPlaying = true","          currentStatue = statue","","      } catch {","          print(\"Failed to play audio: \\(error)\")","      }","  }","  }"],"type":"codeListing","syntax":"swift"},{"text":"SwiftUI Views","anchor":"SwiftUI-Views","type":"heading","level":2},{"text":"Map View Implementation","anchor":"Map-View-Implementation","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Main interface combining map display with statue annotations:"}]},{"code":["  struct MapView: View {","      @State private var locationManager = LocationManager()","      @State private var audioManager = AudioTourManager()","      @State private var viewModel = MapViewModel()","","  var body: some View {","      NavigationStack {","          ZStack {","              Map(coordinateRegion: $viewModel.region,","                  annotationItems: viewModel.statues) { statue in","                  MapAnnotation(coordinate: CLLocationCoordinate2D(","                      latitude: statue.latitude,","                      longitude: statue.longitude","                  )) {","                      StatueMarker(","                          statue: statue,","                          isSelected: viewModel.selectedStatue == statue","                      )","                      .onTapGesture {","                          viewModel.selectStatue(statue)","                      }","                  }","              }","              .onAppear {","                  locationManager.requestLocationPermission()","                  locationManager.startLocationUpdates()","              }","","              VStack {","                  Spacer()","","                  if let selectedStatue = viewModel.selectedStatue {","                      StatueDetailCard(statue: selectedStatue)","                          .transition(.move(edge: .bottom))","                  }","","                  HStack {","                      Spacer()","                      AudioTourButton(isActive: audioManager.isPlaying) {","                          if audioManager.isPlaying {","                              audioManager.stopTour()","                          } else {","                              audioManager.startTour()","                          }","                      }","                  }","                  .padding()","              }","          }","      }","  }","  }"],"type":"codeListing","syntax":"swift"},{"text":"Statue Detail Card","anchor":"Statue-Detail-Card","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Displays statue information with cultural context:"}]},{"code":["  struct StatueDetailCard: View {","      let statue: StatueModel","      @State private var isBookmarked = false","","  var body: some View {","      VStack(alignment: .leading, spacing: 12) {","          HStack {","              VStack(alignment: .leading) {","                  Text(statue.name)","                      .font(.headline)","","                  if let culturalName = statue.culturalName {","                      Text(culturalName)","                          .font(.subheadline)","                          .foregroundStyle(.secondary)","                  }","              }","","              Spacer()","","              Button(action: toggleBookmark) {","                  Image(systemName: isBookmarked ? \"star.fill\" : \"star\")","                      .foregroundColor(isBookmarked ? .yellow : .gray)","              }","          }","","          Text(statue.culturalDescription)","              .font(.body)","              .lineLimit(3)","","          HStack {","              CategoryBadge(category: statue.category)","              Spacer()","              NavigationLink(\"Learn More\") {","                  StatueDetailView(statue: statue)","              }","              .buttonStyle(.borderedProminent)","          }","      }","      .padding()","      .background(.regularMaterial)","      .clipShape(RoundedRectangle(cornerRadius: 16))","      .onAppear {","          isBookmarked = statue.isBookmarked","      }","  }","","  private func toggleBookmark() {","      isBookmarked.toggle()","      \/\/ Update bookmark status in Core Data","      BookmarkService.shared.toggleBookmark(for: statue)","  }","  }"],"type":"codeListing","syntax":"swift"},{"text":"Related Topics","anchor":"Related-Topics","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.tudemaha.arca\/documentation\/Arca\/TechnicalOverview","type":"reference"},{"text":" - High-level architecture overview","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"StatueModel"},{"type":"text","text":" - Core data model reference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocationManager"},{"text":" - Location services API","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"AudioManager","type":"codeVoice"},{"text":" - Audio system reference","type":"text"}]}]}]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"title":"Sample Code","generated":true,"identifiers":["doc:\/\/com.tudemaha.arca\/documentation\/Arca\/TechnicalOverview"],"anchor":"Sample-Code"}],"hierarchy":{"paths":[["doc:\/\/com.tudemaha.arca\/documentation\/Arca"],["doc:\/\/com.tudemaha.arca\/documentation\/Arca","doc:\/\/com.tudemaha.arca\/documentation\/Arca\/TechnicalOverview"]]},"kind":"article","metadata":{"roleHeading":"Article","modules":[{"name":"Arca"}],"role":"article","title":"Implementation"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.tudemaha.arca\/documentation\/Arca\/Implementation"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/arca\/implementation"]}],"sections":[],"references":{"doc://com.tudemaha.arca/documentation/Arca":{"kind":"symbol","type":"topic","role":"collection","title":"Arca","abstract":[{"text":"The self-guided app for statues information spread throughout Bali","type":"text"}],"url":"\/documentation\/arca","identifier":"doc:\/\/com.tudemaha.arca\/documentation\/Arca"},"doc://com.tudemaha.arca/documentation/Arca/TechnicalOverview":{"url":"\/documentation\/arca\/technicaloverview","kind":"article","title":"Technical Overview","type":"topic","role":"collectionGroup","abstract":[{"type":"text","text":"Architecture and implementation details for developers working with the"},{"type":"text","text":" "},{"type":"text","text":"Arca codebase."}],"identifier":"doc:\/\/com.tudemaha.arca\/documentation\/Arca\/TechnicalOverview"}}}